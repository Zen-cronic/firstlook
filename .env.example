# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Storage (GCS) File Storage
GCS_BUCKET_NAME=agentic-cinema-assets
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-key.json

# ClickHouse Cloud (for write leg / app events)
CLICKHOUSE_HOST=sql-clickhouse.clickhouse.com
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=demo
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_ALLOW_WRITE_ACCESS=true

# Public SQL Playground (read leg / 4.56B youtube benchmark)
CLICKHOUSE_PLAYGROUND_HOST=sql-clickhouse.clickhouse.com
CLICKHOUSE_PLAYGROUND_PORT=8443
CLICKHOUSE_PLAYGROUND_USER=demo
CLICKHOUSE_PLAYGROUND_PASSWORD=

# App environment
NODE_ENV=development
PORT=3000
